<!-- Google Analytics API Script -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        fetch('./visitors')
            .then(response => response.json())
            .then(data => {
                const activeUsers = data.rows.reduce((acc, row) => acc + parseInt(row.metricValues[0].value), 0);
                document.getElementById('active-users').innerText = activeUsers;

                const mapData = [];

                data.rows.forEach(row => {
                    const country = row.dimensionValues[0].value;
                    const users = parseInt(row.metricValues[0].value);
                    if (users > 0 && countryCodes[country]) {
                        mapData.push({
                            id: countryCodes[country],
                            name: country,
                            value: users
                        });
                    }
                });

                // Create the map
                am5.ready(function() {
                    var root = am5.Root.new("chartdiv");

                    root.setThemes([
                        am5themes_Animated.new(root)
                    ]);

                    var chart = root.container.children.push(am5map.MapChart.new(root, {
                        panX: "none",
                        panY: "none",
                        wheelX: "none",
                        wheelY: "none",
                        projection: am5map.geoMercator()
                    }));

                    var polygonSeries = chart.series.push(am5map.MapPolygonSeries.new(root, {
                        geoJSON: am5geodata_worldLow,
                        exclude: ["AQ"], // Exclude Antarctica
                        calculateAggregates: true
                    }));

                    // Add data to the polygon series
                    polygonSeries.data.setAll(mapData);

                    polygonSeries.mapPolygons.template.setAll({
                        tooltipText: "{name}: {value} users",
                        interactive: true
                    });

                    polygonSeries.set("heatRules", [{
                        target: polygonSeries.mapPolygons.template,
                        dataField: "value",
                        min: am5.color(0xe5dc36),
                        max: am5.color(0x5faa46),
                        key: "fill"
                    }]);

                    // Default color for countries with no data
                    polygonSeries.mapPolygons.template.set("fill", am5.color(0xe0e0e0));

                    // Update each polygon to set fill and tooltip for countries with data
                    polygonSeries.mapPolygons.each(function(polygon) {
                        const dataItem = polygon.dataItem.dataContext;
                        if (dataItem && dataItem.value) {
                            polygon.set("tooltipText", `${dataItem.name}: ${dataItem.value} users`);
                            polygon.set("fill", am5.color(0x73978B));
                        } else {
                            polygon.set("tooltipText", null);
                            polygon.set("fill", am5.color(0xe0e0e0));
                        }
                    });

                    // Zoom the map
                //     chart.zoomToPoint({ longitude: 0, latitude: 40 }, 1.5, true);
                });
            })
            .catch(error => {
                console.error('Error fetching visitors data:', error);
                document.getElementById('active-users').innerText = 'Error loading data';
            });
    });

    // Mapping country names to their respective ISO 3166-1 alpha-2 country codes
    const countryCodes = {
        "Italy": "IT",
        "United States": "US",
        "France": "FR",
        "Austria": "AT",
